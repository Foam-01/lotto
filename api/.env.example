# Copy to .env (and .env.test for a separate test database) and fill in real values.
# Without this file, `npm run test:e2e` and the app itself cannot start:
# PrismaService.$connect() fails with "Environment variable not found: DATABASE_URL".
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lotto?schema=public"

# Used to sign/verify login tokens (see src/modules/auth/jwt-secret.ts).
# Required in any real deployment — without it the app falls back to the old
# hardcoded value, which is public in this repo's history and not secure.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-value"
