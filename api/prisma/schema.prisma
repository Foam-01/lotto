generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      Int     @id @default(autoincrement())
  name    String?
  user    String  @unique
  pwd     String
  level   String?
  email   String? @unique
  phone   String?
  address String?
}

model Company {
  id      Int    @id @default(autoincrement())
  name    String
  address String
  phone   String
}

model Lotto {
  id              Int              @id @default(autoincrement())
  numbers         String
  roundNumber     Int
  bookNumber      Int
  cost            Int
  sale            Int
  billSaleDetails BillSaleDetail[]
  isCheckBonus    Int              @default(0)
  inSale          Int              @default(0)
}

model BillSale {
  id               Int               @id @default(autoincrement())
  payDate          DateTime?
  createdDate      DateTime
  customerName     String
  customerPhone    String
  customerAddress  String?
  billSaleDetail   BillSaleDetail[]
  payTime          String?
  payRemark        String?
  payAlertDate     DateTime?
  billSaleForSends BillSaleForSend[]
  tranferMoneyDate DateTime?
  tranferMoneyTime String?
  deliverDate      DateTime?
  price            Int?
}

model BillSaleDetail {
  id                    Int                     @id @default(autoincrement())
  billSaleId            Int
  billSale              BillSale                @relation(fields: [billSaleId], references: [id])
  lottoId               Int
  lotto                 Lotto                   @relation(fields: [lottoId], references: [id])
  price                 Int?
  BillSaleDetailIsBonus BillSaleDetailIsBonus[]
}

model BillSaleForSend {
  id           Int      @id @default(autoincrement())
  billSaleId   Int
  billSale     BillSale @relation(fields: [billSaleId], references: [id])
  sendName     String?
  sendDate     DateTime
  sendTime     String
  traceCode    String
  sendPlatform String
  remark       String?
  price        Int
}

model BonusResultDetail {
  id                    Int                     @id @default(autoincrement())
  number                String
  price                 Int
  bonusDate             String
  BillSaleDetailIsBonus BillSaleDetailIsBonus[]
  lottoIsBonuses        LottoIsBonus[]
}

model BillSaleDetailIsBonus {
  id                  Int                @id @default(autoincrement())
  billSaleDetailId    Int
  BillSaleDetail      BillSaleDetail     @relation(fields: [billSaleDetailId], references: [id])
  bonusResultDetailId Int?
  BonusResultDetail   BonusResultDetail? @relation(fields: [bonusResultDetailId], references: [id])
}

model LottoIsBonus {
  id                  Int               @id @default(autoincrement())
  // relation = รี-เล-ชั่น = เชื่อมความสัมพันธ์   // references =  เรฟ-เฟอ-เริน = อ้างอิง
  // SQL query = คำสั่งค้นข้อมูล จากฐานข้อมูล  = คิว-รี่
  bonusResultDetailId Int
  BonusResultDetail   BonusResultDetail @relation(fields: [bonusResultDetailId], references: [id])
}

model Banner {
  id        Int      @id @default(autoincrement())
  name      String   // ชื่อแบนเนอร์ (เอาไว้ให้ Admin ดูง่ายๆ)
  src       String   // URL หรือที่อยู่ของไฟล์รูปภาพ

  // 🌟 1. สิ่งที่ "ควรมี" (เสริมความเก่งให้ระบบ)
  link      String?  // ลิงก์ปลายทาง (เวลากดรูปแล้วให้เด้งไปหน้าไหน ใส่ ? เพราะบางรูปอาจจะแค่โชว์เฉยๆ ไม่มีลิงก์)
  alt       String?  // คำอธิบายรูปภาพ (สำคัญมากสำหรับ SEO และผู้พิการทางสายตา)
  sequence  Int      @default(0) // ลำดับการโชว์รูป (เลขน้อยขึ้นก่อน จะได้เรียงลำดับแบนเนอร์ได้ตามใจชอบ)
  isActive  Boolean  @default(true) // ปุ่มเปิด-ปิด (หมดโปรโมชั่นก็แค่กดปิด ไม่ต้องลบรูบทิ้ง)

  // 🌟 2. ถ้าระบบเป็น V.VIP (ตั้งเวลาแสดงผลอัตโนมัติ)
  startDate DateTime? // ตั้งเวลาให้แบนเนอร์เริ่มโชว์
  endDate   DateTime? // ตั้งเวลาให้แบนเนอร์หายไปเอง (เหมาะกับโปรโมชั่นที่มีวันหมดอายุ)

  // 🌟 3. ข้อมูลพื้นฐานที่ "ต้องมี" ทุกตาราง (Audit Trail)
  createdAt DateTime @default(now()) // บันทึกว่าสร้างเมื่อไหร่
  updatedAt DateTime @updatedAt      // บันทึกว่าอัปเดตครั้งสุดท้ายเมื่อไหร่
}


